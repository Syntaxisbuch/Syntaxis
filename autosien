      <h1 class="font-serif text-5xl md:text-8xl tracking-tight font-black text-bone uppercase mb-6 drop-shadow-2xl">
        SYNTAXIS
      </h1>
      
      <p class="max-w-2xl mx-auto text-lg md:text-xl text-subtle font-light leading-relaxed mb-12">
        Wo Urteile enden, beginnt der Schnitt. Wir zerlegen Mythen mit chirurgischer Präzision – 
        <span class="text-bone font-normal">ohne Gnade für die Lüge, aber mit tiefem Respekt für den Suchenden.</span>
      </p>

      <!-- Interaktiver Lichttisch: "Der erste Schnitt" -->
      <div class="max-w-3xl mx-auto text-left relative scrutiny-container bg-panel/60 p-8 md:p-10 rounded-2xl border border-white/10 backdrop-blur-xl shadow-2xl overflow-hidden cursor-crosshair" id="scrutiny-box">
        
        <!-- Untere Schicht (Verschwommen / Das Dogma) -->
        <div class="select-none filter blur-[2px] opacity-40 transition-all duration-300">
          <p class="font-mono text-xs uppercase tracking-widest text-zinc-500 mb-2">// OBERFLÄCHENSCHEIN (MYTHOS)</p>
          <p class="text-xl md:text-2xl font-serif text-zinc-400 italic">
            „Die Sinne sind unfehlbar. Was nicht sichtbar ist, existiert nicht. Wenn die Welt bedrohlich komplex wird, biege den Horizont zurecht, bis er dich schützt.“
          </p>
        </div>

        <!-- Obere Schicht (Freigelegt / Die Wahrheit via Scrutiny Cursor) -->
        <div class="scrutiny-revealed p-8 md:p-10 text-left bg-void/90 border border-white/20 rounded-2xl">
          <p class="font-mono text-xs uppercase tracking-widest text-emerald-400 mb-2 font-bold">// AUTOPSIE-ERGEBNIS (DIE WAHRHEIT)</p>
          <p class="text-xl md:text-2xl font-serif text-bone font-medium">
            „Kein Mythos entsteht aus Dummheit; er entsteht aus kosmischer Überforderung. Wer den Horizont seziert, nimmt dem Menschen nicht den Halt, sondern baut ihm ein echtes Fundament.“
          </p>
        </div>

        <div class="mt-6 flex justify-between items-center text-[11px] font-mono text-zinc-500 pt-4 border-t border-white/5">
          <span>[ HINWEIS: BEWEGE DEN CURSOR ZUM SEZIEREN ]</span>
          <span class="text-zinc-400 font-mono">STAHLMANN-DIAGNOSE</span>
        </div>
      </div>
    </section>

    <!-- Die Methode Section -->
    <section id="methode" class="max-w-7xl mx-auto px-6 py-20 border-t border-white/5">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 rounded-xl bg-surface border border-white/5 hover:border-white/10 transition-all">
          <div class="font-mono text-xs text-amberLvl mb-3">01 // DER STAHLMANN-STANDARD</div>
          <h3 class="font-serif text-xl text-bone mb-2">Die stärkste Version</h3>
          <p class="text-sm text-subtle leading-relaxed">
            Wir bekämpfen keine Strohmänner. Wir prüfen jeden Mythos in seiner stärksten, logischsten und emotional plausibelsten Form, bevor der Schnitt gesetzt wird.
          </p>
        </div>
        <div class="p-6 rounded-xl bg-surface border border-white/5 hover:border-white/10 transition-all">
          <div class="font-mono text-xs text-cyanGlow mb-3">02 // RADIKALE EMPATHIE</div>
          <h3 class="font-serif text-xl text-bone mb-2">Mensch vs. Narrativ</h3>
          <p class="text-sm text-subtle leading-relaxed">
            Hinter jeder Verschwörungstheorie liegt ein echtes menschliches Bedürfnis nach Kontrolle, Würde und Sinn. Wir heilen den Patienten, während wir das Dogma entfernen.
          </p>
        </div>
        <div class="p-6 rounded-xl bg-surface border border-white/5 hover:border-white/10 transition-all">
          <div class="font-mono text-xs text-scarlet mb-3">03 // UNERBITTLICHE LOGIK</div>
          <h3 class="font-serif text-xl text-bone mb-2">Der Skalpell-Schnitt</h3>
          <p class="text-sm text-subtle leading-relaxed">
            Keine faulen Kompromisse. Wo Evidenz und physikalische Gesetzmäßigkeit stehen, weicht die Illusion ohne Ausnahme.
          </p>
        </div>
      </div>
    </section>

    <!-- Das Regal: Die Bände (#01 bis #04 Showcase) -->
    <section id="regal" class="max-w-7xl mx-auto px-6 py-20 border-t border-white/5">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
        <div>
          <span class="font-mono text-xs text-zinc-500 uppercase tracking-widest">// DOSSIER-REGISTER</span>
          <h2 class="font-serif text-3xl md:text-4xl text-bone mt-1 font-bold">Die Autopsie-Bände</h2>
        </div>
        <p class="text-subtle text-sm mt-2 md:mt-0 font-mono">WÄHLE EIN DOSSIER ZUM ÖFFNEN</p>
      </div>

      <!-- Dossier Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="dossier-grid">
        <!-- Dynamisch gerendert via JS -->
      </div>
    </section>

    <!-- Terminal & Metadaten Section -->
    <section id="terminal" class="max-w-5xl mx-auto px-6 py-20 border-t border-white/5 font-mono">
      <div class="bg-black border border-white/15 rounded-xl shadow-2xl overflow-hidden">
        <div class="bg-panel px-4 py-3 border-b border-white/10 flex items-center justify-between text-xs text-subtle">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
            <span class="ml-2 text-zinc-400 font-bold">syntaxis_terminal@github-node: ~</span>
          </div>
          <span>SCHLIFF_V2.6.LOG</span>
        </div>
        <div class="p-6 text-xs md:text-sm text-zinc-300 space-y-3 leading-relaxed">
          <p class="text-emerald-400">$ ./fetch_autopsy_summary.sh --all</p>
          <p class="text-zinc-500">> Initialisiere heuristisches Skalpell...</p>
          <p class="text-zinc-400">> Verifizierungs-Index: <span class="text-bone">100% Peer-Reviewed Physics & Cognitive Science</span></p>
          <p class="text-zinc-400">> Aktive Bände im Repository: <span class="text-amberLvl font-bold">4 Bände geladen (6 in Vorbereitung)</span></p>
          <p class="text-zinc-400">> Lizenzstatus: <span class="text-cyanGlow">Creative Commons CC BY-NC 4.0</span> (Open Research)</p>
          <div class="pt-3 border-t border-white/10 text-zinc-500">
            [READY] Wählen Sie einen Band oben oder binden Sie eigene Daten in <span class="text-bone">dossiers.json</span> ein.
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Dossier Modal / Detail Drawer -->
  <div id="modal-backdrop" class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 opacity-0 pointer-events-none transition-opacity duration-300 flex justify-end">
    <div id="dossier-drawer" class="w-full max-w-2xl bg-panel border-l border-white/10 h-full p-8 md:p-12 overflow-y-auto transform translate-x-full transition-transform duration-300 flex flex-col justify-between">
      
      <div>
        <div class="flex items-center justify-between border-b border-white/10 pb-6 mb-8">
          <span id="modal-vol-id" class="font-mono text-xs px-2.5 py-1 bg-white/5 border border-white/10 rounded text-amberLvl">VOL_01</span>
          <button id="close-modal-btn" class="font-mono text-xs text-subtle hover:text-bone uppercase tracking-wider px-3 py-1.5 border border-white/10 rounded">
            [ SCHLIESSEN ✕ ]
          </button>
        </div>

        <h3 id="modal-title" class="font-serif text-3xl font-bold text-bone mb-3">Titel</h3>
        <p id="modal-mode" class="font-mono text-xs text-subtle mb-8">Modus: Sezierend-analytisch</p>

        <div class="space-y-6">
          <div class="bg-surface p-5 rounded-lg border border-white/5">
            <h4 class="font-mono text-xs text-zinc-400 uppercase tracking-widest mb-2">// DER SCHEIN (VOR DEM SCHNITT)</h4>
            <p id="modal-schein" class="text-sm text-zinc-300 italic font-serif leading-relaxed"></p>
          </div>

          <div class="bg-surface p-5 rounded-lg border border-emerald-500/20">
            <h4 class="font-mono text-xs text-emerald-400 uppercase tracking-widest mb-2">// DIE AUTOPSIE (NACH DEM SCHNITT)</h4>
            <p id="modal-autopsie" class="text-sm text-bone font-sans leading-relaxed"></p>
          </div>

          <div class="p-5 rounded-lg border border-white/5 bg-void">
            <h4 class="font-mono text-xs text-zinc-400 uppercase tracking-widest mb-2">// TERMINAL DIAGNOSE & STAHLMANN</h4>
            <pre id="modal-terminal" class="font-mono text-xs text-zinc-400 whitespace-pre-wrap leading-relaxed"></pre>
          </div>
        </div>
      </div>

      <div class="pt-8 mt-8 border-t border-white/10 flex justify-between items-center text-xs font-mono text-zinc-500">
        <span>CC BY-NC 4.0</span>
        <span>SYNTAXIS ARCHIV</span>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="border-t border-white/5 bg-surface/50 py-10 font-mono text-xs text-zinc-500">
    <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-4">
      <div>
        <p class="text-zinc-400 font-bold">SYNTAXIS — Meister-Autopsien der Schatten</p>
        <p class="text-[11px] text-zinc-600 mt-1">Gehostet via GitHub Pages. Alle Inhalte unter CC BY-NC 4.0.</p>
      </div>
      <div class="flex items-center gap-6">
        <a href="https://creativecommons.org/licenses/by-nc/4.0/deed.de" target="_blank" class="hover:text-bone transition-colors">Lizenzdetails</a>
        <a href="#" class="hover:text-bone transition-colors">Repository</a>
      </div>
    </div>
  </footer>

  <!-- Scripts -->
  <script>
    // 1. Datenbestand der Bände
    const dossiers = [
      {
        id: "VOL_01",
        title: "Das Kuppeldogma",
        subtitle: "Flache Erde & die Sehnsucht nach dem Rand",
        level: "L2",
        levelColor: "text-amberLvl border-amberLvl/30 bg-amberLvl/10",
        mode: "Phänomenologisch empathisch",
        schein: "„Die Erde ruht. Das Auge lügt nicht. Wenn Wasser stets sein Niveau sucht, warum sollte sich ein Ozean um eine Kugel krümmen? Vertraue nur dem, was du direkt sehen kannst.“",
        autopsie: "„Die Flache Erde ist kein geometrischer Irrtum – sie ist eine Panikreaktion auf den kosmischen Schwindel. Wer den Horizont flachbiegt, sucht keine Physik, sondern ein Dach über dem Kopf.“",
        terminal: `TARGET        : Flat Earth Paradigm\nSTATUS        : SEZIERT & VERIFIZIERT\nSCHNITT-TIEFE : 99.2%\nBIAS_TYPE     : Naive Realism / Cosmological Vertigo\nSTREITPUNKT   : Gravitation vs. Anthropozentrische Geborgenheit`
      },
      {
        id: "VOL_02",
        title: "Die Kaltblüter",
        subtitle: "Echsenmenschen & die Entmenschlichung der Macht",
        level: "L4",
        levelColor: "text-crimsonLvl border-crimsonLvl/30 bg-crimsonLvl/10",
        mode: "Chirurgisch-unerbittlich",
        schein: "„Hinter den Masken der globalen Institutionen regiert eine uralte, empathielose Spezies, die das Leid der Menschheit als Nahrung nutzt.“",
        autopsie: "„Das Echsen-Narrativ ist die groteske Karikatur realer Entfremdung. Es verwandelt komplexe systemische Ausbeutung in ein Comic-Monster, das man hassen kann, ohne die eigenen Verstrickungen im System verstehen zu müssen.“",
        terminal: `TARGET        : Reptilian Elite Myth\nSTATUS        : SEZIERT & VERIFIZIERT\nSCHNITT-TIEFE : 98.7%\nBIAS_TYPE     : Radical Othering / Systemic Complexity Overload\nSTREITPUNKT   : Soziologische Entfremdung vs. Biologischer Dämon`
      },
      {
        id: "VOL_03",
        title: "Das Staub-Theater",
        subtitle: "Apollo 11 & das Studio-Paradoxon",
        level: "L2",
        levelColor: "text-amberLvl border-amberLvl/30 bg-amberLvl/10",
        mode: "Technisch-analytisch",
        schein: "„Die wehende Flagge, die fehlenden Sterne, das perfekte Licht im Vakuum: Eine technologische Meisterleistung aus den Studios von Hollywood.“",
        autopsie: "„Es wäre im Kalten Krieg unendlich viel einfacher gewesen, auf den Mond zu fliegen, als 400.000 Wissenschaftler und die gesamte Sowjetische Spionageabwehr 50 Jahre lang zu täuschen.“",
        terminal: `TARGET        : Moon Landing Hoax\nSTATUS        : SEZIERT & VERIFIZIERT\nSCHNITT-TIEFE : 99.9%\nBIAS_TYPE     : Institutional Distrust / Technical Intuition Failure\nSTREITPUNKT   : Retroreflektor-Laserdaten vs. Cineastische Skepsis`
      },
      {
        id: "VOL_04",
        title: "Die Frequenz-Hysterie",
        subtitle: "5G, Strahlung & unsichtbare Feinde",
        level: "L3",
        levelColor: "text-amberLvl border-amberLvl/30 bg-amberLvl/10",
        mode: "Biophysikalisch",
        schein: "„Die unsichtbaren Wellen durchdringen unsere Zellen, schwächen das Immunsystem und dienen der lückenlosen Verhaltenskontrolle.“",
        autopsie: "„Elektromagnetische Ängste entstehen dort, wo Technologie unsichtbar und allgegenwärtig wird. Nicht ionisierende Strahlung transportiert Daten, aber kein biologisches Gift.“",
        terminal: `TARGET        : Cellular Frequency Paranoia\nSTATUS        : SEZIERT & VERIFIZIERT\nSCHNITT-TIEFE : 97.5%\nBIAS_TYPE     : Somatization / Invisible Threat Bias\nSTREITPUNKT   : Quantenenergie-Grenzwerte vs. Nocebo-Effekt`
      }
    ];

    // 2. Scrutiny Cursor Engine (Lichttisch)
    const scrutinyBox = document.getElementById('scrutiny-box');
    scrutinyBox.addEventListener('mousemove', (e) => {
      const rect = scrutinyBox.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      scrutinyBox.style.setProperty('--mouse-x', `${x}px`);
      scrutinyBox.style.setProperty('--mouse-y', `${y}px`);
    });

    scrutinyBox.addEventListener('mouseleave', () => {
      scrutinyBox.style.setProperty('--mouse-x', `-500px`);
      scrutinyBox.style.setProperty('--mouse-y', `-500px`);
    });

    // 3. Grid dynamisch befüllen
    const grid = document.getElementById('dossier-grid');
    dossiers.forEach((dossier) => {
      const card = document.createElement('div');
      card.className = "p-6 rounded-xl bg-surface border border-white/5 hover:border-white/20 transition-all duration-300 flex flex-col justify-between group cursor-pointer hover:bg-panel";
      card.onclick = () => openDossier(dossier);

      card.innerHTML = `
        <div>
          <div class="flex items-center justify-between font-mono text-xs mb-4">
            <span class="text-zinc-500">${dossier.id}</span>
            <span class="px-2 py-0.5 rounded border text-[11px] font-bold ${dossier.levelColor}">${dossier.level}</span>
          </div>
          <h3 class="font-serif text-2xl text-bone group-hover:text-amberLvl transition-colors font-bold mb-1">${dossier.title}</h3>
          <p class="text-xs text-subtle font-mono mb-4">${dossier.subtitle}</p>
        </div>
        <div class="pt-4 border-t border-white/5 flex items-center justify-between font-mono text-xs text-zinc-500 group-hover:text-zinc-300">
          <span>${dossier.mode}</span>
          <span class="group-hover:translate-x-1 transition-transform">ÖFFNEN →</span>
        </div>
      `;
      grid.appendChild(card);
    });

    // 4. Modal / Drawer Steuerung
    const modalBackdrop = document.getElementById('modal-backdrop');
    const drawer = document.getElementById('dossier-drawer');
    const closeBtn = document.getElementById('close-modal-btn');

    function openDossier(data) {
      document.getElementById('modal-vol-id').innerText = data.id;
      document.getElementById('modal-title').innerText = data.title + " — " + data.subtitle;
      document.getElementById('modal-mode').innerText = "MODUS: " + data.mode.toUpperCase();
      document.getElementById('modal-schein').innerText = data.schein;
      document.getElementById('modal-autopsie').innerText = data.autopsie;
      document.getElementById('modal-terminal').innerText = data.terminal;

      modalBackdrop.classList.remove('pointer-events-none');
      modalBackdrop.classList.remove('opacity-0');
      modalBackdrop.classList.add('opacity-100');
      drawer.classList.remove('translate-x-full');
    }

    function closeDossier() {
      drawer.classList.add('translate-x-full');
      modalBackdrop.classList.add('opacity-0');
      modalBackdrop.classList.remove('opacity-100');
      setTimeout(() => {
        modalBackdrop.classList.add('pointer-events-none');
      }, 300);
    }

    closeBtn.onclick = closeDossier;
    modalBackdrop.onclick = (e) => {
      if (e.target === modalBackdrop) closeDossier();
    };

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeDossier();
    });
  </script>
</body>
</html>
