  <main>
    <!-- Hero Section: Die Dekonstruktion -->
    <section class="max-w-7xl mx-auto px-6 pt-24 pb-20 md:pt-32 md:pb-28 text-center relative">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/10 bg-white/[0.02] text-xs font-mono text-zinc-400 mb-8">
        <span class="text-amberLvl">●</span> MEISTER-AUTOPSIEN DER SCHATTEN
